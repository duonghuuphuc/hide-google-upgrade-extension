{
  "manifest_version": 3,
  "name": "Hide Google Apps Upgrade Button",
  "version": "1.0",
  "description": "Removes the Upgrade button and Gemini AI elements from Google Workspace apps.",
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon/icon16.png",
      "48": "icon/icon48.png",
      "128": "icon/icon128.png"
    },
    "default_title": "Hide Google Workspace Upgrade Buttons"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/*",
        "https://drive.google.com/*",
        "https://mail.google.com/*"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start"
    }
  ]
}